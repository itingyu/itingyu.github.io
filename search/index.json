---
layout: null
permalink: /search/index.json
sitemap: false
---
{%- assign indexed = site.posts | where_exp: "p", "p.draft != true" -%}
{
  "generated": "{{ site.time | date: '%Y-%m-%d' }}",
  "posts": [
    {%- for p in indexed -%}
    {
      "id": {{ p.slug | jsonify }},
      "url": {{ p.url | absolute_url | jsonify }},
      "title": {{ p.title | jsonify }},
      "description": {{ p.excerpt | default: '' | jsonify }},
      "tags": [
        {%- for t in p.tags -%}{{ t | jsonify }}{% unless forloop.last %},{% endunless %}{%- endfor -%}
      ],
      "date": "{{ p.date | date: '%Y-%m-%d' }}",
      "excerpt": {{ p.excerpt | default: '' | jsonify }},
      "content": {{ p.content | strip_html | normalize_whitespace | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
