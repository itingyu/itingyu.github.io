---
layout: null
permalink: /search/index.json
sitemap: false
---
{
  "generated": "{{ site.time | date: '%Y-%m-%dT%H:%M:%S%z' }}",
  "posts": [
    {%- assign _first = true -%}
    {%- for p in site.posts -%}
      {%- if p.draft -%}{%- continue -%}{%- endif -%}
      {%- unless _first -%},{%- endunless -%}
      {"id":"{{ p.slug }}","url":"{{ p.url }}","title":{{ p.title | jsonify }},"description":{{ p.description | default: '' | jsonify }},"tags":[{%- for t in p.tags -%}{%- if t.tag -%}{{ t.tag | jsonify }}{%- else -%}{{ t | jsonify }}{%- endif -%}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],"date":"{{ p.date | date: '%Y-%m-%d' }}","excerpt":{{ p.excerpt | default: '' | jsonify }},"content":{{ p.content | strip_html | normalize_whitespace | truncate: 4000 | jsonify }}}
      {%- assign _first = false -%}
    {%- endfor -%}
  ]
}