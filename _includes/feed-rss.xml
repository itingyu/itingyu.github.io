{%- comment -%}
  feed-rss.xml — 全站 RSS 2.0 频道模板（§D9 + AC-12）

  由 feeds/rss.xml 包含：
    ---
    permalink: /feeds/rss.xml
    sitemap: false
    ---
    {% include feed-rss.xml %}

  字段级契约（与 v1 归一化后等值）：
    channel.title / link / description / language / lastBuildDate
    atom:link[rel=self] / atom:link[rel=related] × 2
    item.title / link / guid(isPermaLink=true) / pubDate / description / content:encoded

  顺序：site.posts 已按 date desc 排序（§D14 同日时间戳方案）
  草稿门禁：site.posts 已自动排除 draft: true
  CJK URL：手拼 site.url + /series/<slug>/ 用 slug 原值（Jekyll url 字段会自动 percent-encode CJK，绕开）
{%- endcomment -%}
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <link>{{ site.url }}/</link>
    <description>{{ site.description | xml_escape }}</description>
    <language>{{ site.lang | xml_escape }}</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <atom:link href="{{ site.url }}/feeds/rss.xml" rel="self" type="application/rss+xml" />
{%- for s in site.series %}
    <atom:link href="{{ site.url }}/feeds/series-{{ s.slug }}.xml" rel="related" type="application/rss+xml" title="{{ s.title | xml_escape }}" />
{%- endfor %}
{%- for post in site.posts %}
    <item>
      <title>{{ post.title | xml_escape }}</title>
      <link>{{ site.url }}{{ post.url }}</link>
      <guid isPermaLink="true">{{ site.url }}{{ post.url }}</guid>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
      <description>{{ post.excerpt | xml_escape }}</description>
      <content:encoded><![CDATA[{{ post.content }}]]></content:encoded>
    </item>
{%- endfor %}
  </channel>
</rss>