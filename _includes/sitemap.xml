{%- comment -%}
  sitemap.xml — 站点地图（§D9 + AC-14）

  由 sitemap.xml 包含：
    ---
    permalink: /sitemap.xml
    sitemap: false
    ---
    {% include sitemap.xml %}

  <url> 集合：聚合页（首页/posts/archive/series/search）+ 专栏页 + 文章页。无标签页。
  聚合页覆盖 5 条（首页/posts/archive/series/search）

  字段级契约（与 v1 等值）：
    <loc>、<lastmod>（date-only）、<changefreq>、<priority>
    有专栏的文章带 <series><显示名原值></series>
    lastmod = 站点最新构建时间（聚合页与 tag 页统一；文章页用 post.date；专栏页用 series_doc 的最近一篇文章日期）

  CJK URL：用 s.slug 拼路径，避开 Jekyll url 字段的 percent-encode（§3.2 / AC-07）
{%- endcomment -%}
{%- assign build_date = site.time | date: "%Y-%m-%d" -%}
{%- assign latest_post_date = site.posts.first.date | date: "%Y-%m-%d" -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ site.url }}/</loc><lastmod>{{ build_date }}</lastmod><changefreq>weekly</changefreq><priority>1.0</priority></url>
  <url><loc>{{ site.url }}/posts/</loc><lastmod>{{ latest_post_date }}</lastmod><changefreq>weekly</changefreq><priority>0.9</priority></url>
  <url><loc>{{ site.url }}/archive/</loc><lastmod>{{ latest_post_date }}</lastmod><changefreq>weekly</changefreq><priority>0.7</priority></url>
  <url><loc>{{ site.url }}/series/</loc><lastmod>{{ latest_post_date }}</lastmod><changefreq>weekly</changefreq><priority>0.6</priority></url>
  <url><loc>{{ site.url }}/search/</loc><lastmod>{{ build_date }}</lastmod><changefreq>monthly</changefreq><priority>0.4</priority></url>
{%- for s in site.series %}
{%- assign series_latest = site.posts | where: "series", s.title | first -%}
  <url><loc>{{ site.url }}/series/{{ s.slug }}/</loc><lastmod>{{ series_latest.date | date: "%Y-%m-%d" }}</lastmod><changefreq>monthly</changefreq><priority>0.5</priority></url>
{%- endfor %}
{%- for post in site.posts %}
  <url><loc>{{ site.url }}{{ post.url }}</loc>{% if post.series %}<series>{{ post.series | xml_escape }}</series>{% endif %}<lastmod>{{ post.date | date: "%Y-%m-%d" }}</lastmod><changefreq>monthly</changefreq><priority>0.8</priority></url>
{%- endfor %}
</urlset>