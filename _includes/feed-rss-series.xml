{%- comment -%}
  feed-rss-series.xml — per-series RSS 2.0 频道模板（§D2 + §D9 + AC-13）

  由 feeds/series-<显示名>.xml 包含：
    ---
    permalink: /feeds/series-<显示名>.xml
    sitemap: false
    series: <显示名>
    ---
    {% include feed-rss-series.xml %}

  系列显示名通过 front matter `series:` 传入；
  拉取 site.series 找对应文档拿到 description；
  过滤 site.posts 取 series == page.series 且非草稿。

  字段级契约：
    channel.title = "<系列> · itingyu"
    channel.link = 专栏 URL（/series/<slug>/，CJK 原值，不 encode）
    channel.description = _series/<slug>.md 的 description
    atom:link[rel=self] / atom:link[rel=alternate]
    item 集合 = 同专栏非草稿文章（顺序按 date desc，与 v1 厨房 15 / 金融 5 一致）
{%- endcomment -%}
{%- assign series_doc = site.series | where: "title", page.series | first -%}
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ page.series | xml_escape }} · itingyu</title>
    <link>{{ site.url }}/series/{{ series_doc.slug }}/</link>
    <description>{{ series_doc.description | xml_escape }}</description>
    <language>{{ site.lang | xml_escape }}</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <atom:link href="{{ site.url }}{{ page.url }}" rel="self" type="application/rss+xml" />
    <atom:link href="{{ site.url }}/series/{{ series_doc.slug }}/" rel="alternate" type="text/html" />
{%- assign series_posts = site.posts | where: "series", page.series -%}
{%- for post in series_posts %}
    <item>
      <title>{{ post.title | xml_escape }}</title>
      <link>{{ site.url }}{{ post.url }}</link>
      <guid isPermaLink="true">{{ site.url }}{{ post.url }}</guid>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
      <description>{{ post.excerpt | xml_escape }}</description>
      <content:encoded><![CDATA[{{ post.content }}]]></content:encoded>
    </item>
{%- endfor %}
  </channel>
</rss>